<Window x:Class="WorkspaceLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:WorkspaceLauncher.ViewModels"
        xmlns:views="clr-namespace:WorkspaceLauncher.Views"
        mc:Ignorable="d"
        Title="Workspace Launcher" 
        Height="700" Width="1050"
        MinWidth="950" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource PremiumWindowStyle}">

    <Window.Resources>
        <!-- View Resolution Templates -->
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:WorkflowEditorViewModel}">
            <views:WorkflowEditorView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SessionCaptureViewModel}">
            <views:SessionCaptureView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>

        <!-- Sidebar Navigation Button Style -->
        <Style x:Key="SidebarButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="Transparent" CornerRadius="8" SnapsToDevicePixels="true">
                            <ContentPresenter Margin="{TemplateBinding Padding}" 
                                              HorizontalAlignment="Left" 
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="true">
                                <Setter TargetName="border" Property="Background" Value="#171722" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="Cursor" Value="Hand"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" /> <!-- Sidebar -->
            <ColumnDefinition Width="1" />   <!-- Divider border -->
            <ColumnDefinition Width="*" />   <!-- Client Viewport -->
        </Grid.ColumnDefinitions>

        <!-- Sidebar Navigation Pane -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Logo/Brand -->
                <RowDefinition Height="*" />    <!-- Navigation Items -->
                <RowDefinition Height="Auto" /> <!-- Bottom Action (Create Workspace) -->
            </Grid.RowDefinitions>

            <!-- Brand Header -->
            <StackPanel Grid.Row="0" Margin="20,24,20,24" Orientation="Horizontal">
                <!-- App Logo Geometry -->
                <Border Width="32" Height="32" CornerRadius="8" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                    <Path Data="M19,19H5V5h7V3H5C3.89,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2v-7h-2V19z" 
                          Fill="White" Width="14" Height="14" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Workspace" Foreground="White" FontSize="15" FontWeight="Bold" LineHeight="15"/>
                    <TextBlock Text="Launcher" Foreground="{StaticResource AccentHoverBrush}" FontSize="12" FontWeight="SemiBold" LineHeight="12" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- Navigation Links -->
            <StackPanel Grid.Row="1" Margin="12,0">
                <TextBlock Text="CORE SYSTEM" Foreground="{StaticResource TextMutedBrush}" FontSize="10" FontWeight="Bold" Margin="8,0,0,10" />
                
                <!-- Dashboard Nav -->
                <Button Command="{Binding NavigateDashboardCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#171324"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-9 14H5v-2h5v2zm0-4H5v-2h5v2zm0-4H5V7h5v2zm9 8h-7v-2h7v2zm0-4h-7v-2h7v2zm0-4h-7V7h7v2z" 
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Dashboard">
                                            <Setter Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Dashboard" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- Session Capture Nav -->
                <Button Command="{Binding NavigateCaptureCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveSection}" Value="Capture">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#171324"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z" 
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Capture">
                                            <Setter Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Capture Session" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" />
                    </StackPanel>
                </Button>

                <!-- Settings Nav -->
                <Button Command="{Binding NavigateSettingsCommand}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SidebarButton}">
                            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ActiveSection}" Value="Settings">
                                    <Setter Property="Foreground" Value="White" />
                                    <Setter Property="Background" Value="#171324"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.70,1.62,0.94l0.36,2.54c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z" 
                              Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center">
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ActiveSection}" Value="Settings">
                                            <Setter Property="Fill" Value="{StaticResource AccentHoverBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                        <TextBlock Text="Settings" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Margin="12,0,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Bottom Create Workspace Trigger -->
            <Border Grid.Row="2" Padding="12,16" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Button Style="{StaticResource PrimaryButton}" 
                        Command="{Binding CreateNewWorkflowCommand}"
                        HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Path Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z" 
                              Fill="White" Width="10" Height="10" Margin="0,0,6,0" Stretch="Uniform" />
                        <TextBlock Text="New Workspace" FontSize="11" />
                    </StackPanel>
                </Button>
            </Border>
        </Grid>

        <!-- Divider line -->
        <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />

        <!-- Main Window Client Area (Viewport) -->
        <Grid Grid.Column="2" Background="{StaticResource BackgroundBrush}">
            <!-- Dynamic view injection -->
            <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />
        </Grid>
    </Grid>
</Window>
