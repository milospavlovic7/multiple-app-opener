<UserControl x:Class="WorkspaceLauncher.Views.SessionCaptureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:models="clr-namespace:WorkspaceLauncher.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <!-- Converter to toggle visibility on boolean invert -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Info -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Capture Current Session" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="24" 
                           FontWeight="Bold" />
                <TextBlock Text="Review running apps, explorer directories, and browser tabs to auto-generate a workspace." 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="13" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Style="{StaticResource SecondaryButton}" 
                    Command="{Binding CaptureCommand}"
                    Padding="16,10"
                    IsEnabled="{Binding IsCapturing, Converter={x:Null}, FallbackValue=True}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M12 6v6h6v2h-6v6h-2v-6H5v-2h6V6h2z M17.657 16.243l1.414 1.414L12 24.828l-7.071-7.071l1.414-1.414L12 22l5.657-5.757z" 
                          Fill="White" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" />
                    <TextBlock Text="Recapture Session" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Main Workspace Review Screen -->
        <Grid Grid.Row="1" Margin="0,0,0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Name of Workspace -->
            <StackPanel Grid.Row="0" Margin="0,0,0,16">
                <TextBlock Text="New Workspace Name" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="12" 
                           FontWeight="SemiBold" 
                           Margin="0,0,0,6"/>
                <TextBox Text="{Binding NewWorkflowName, UpdateSourceTrigger=PropertyChanged}" 
                         Padding="12,10" 
                         FontSize="14"/>
            </StackPanel>

            <!-- Table Header -->
            <Border Grid.Row="1" Background="#13131A" CornerRadius="4,4,0,0" Padding="12,8" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1,1,1,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="40" />  <!-- Checkbox -->
                        <ColumnDefinition Width="36" />  <!-- Icon -->
                        <ColumnDefinition Width="220" /> <!-- Window Name/App Name -->
                        <ColumnDefinition Width="*" />   <!-- Path or URL Fallback -->
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Save" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="Window Title / Application" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="Path / Target URL" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="Bold" Margin="12,0,0,0"/>
                </Grid>
            </Border>

            <!-- Captured Items List -->
            <Border Grid.Row="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="0,0,4,4">
                <ListBox ItemsSource="{Binding CapturedItems}" 
                         Background="Transparent" 
                         BorderThickness="0" 
                         Padding="0" 
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
                            <Setter Property="BorderThickness" Value="0,0,0,1"/>
                            <Setter Property="Padding" Value="12,10"/>
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Background="{TemplateBinding Background}" 
                                                BorderBrush="{TemplateBinding BorderBrush}" 
                                                BorderThickness="{TemplateBinding BorderThickness}" 
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#171720"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:CapturedItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />  <!-- Checkbox -->
                                    <ColumnDefinition Width="36" />  <!-- Icon -->
                                    <ColumnDefinition Width="220" /> <!-- Window Name/App Name (Editable) -->
                                    <ColumnDefinition Width="*" />   <!-- Path or URL Input -->
                                </Grid.ColumnDefinitions>

                                <!-- Checkbox -->
                                <CheckBox Grid.Column="0" 
                                          IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" 
                                          HorizontalAlignment="Center" VerticalAlignment="Center"/>

                                <!-- Icon -->
                                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="4" Background="#1D1D2C" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Fill="White" Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.App}">
                                                        <Setter Property="Data" Value="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Url}">
                                                        <Setter Property="Data" Value="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Folder}">
                                                        <Setter Property="Data" Value="M10,4H4C2.9,4,2.01,4.9,2.01,6L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.File}">
                                                        <Setter Property="Data" Value="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.89,2,1.99,2H18c1.1,0,2-0.9,2-2V8L14,2z" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Border>

                                <!-- Window Name / App Name (Editable) -->
                                <TextBox Grid.Column="2" 
                                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                         FontWeight="SemiBold" 
                                         FontSize="12" 
                                         VerticalAlignment="Center" 
                                         Background="Transparent" 
                                         BorderThickness="0" 
                                         Padding="0"/>

                                <!-- Path or URL (Dynamic Warning) -->
                                <Grid Grid.Column="3" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- If URL is VALID or is App/Folder: Just show PathOrUrl text -->
                                    <TextBlock Grid.Row="0" Text="{Binding PathOrUrl}" 
                                               Foreground="{StaticResource TextSecondaryBrush}" 
                                               FontSize="11" 
                                               TextTrimming="CharacterEllipsis" 
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <!-- Hide text block if URL is NOT valid and item is selected -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsUrlValid}" Value="False" />
                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:ActionType.Url}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- IF URL IS INVALID: Prompt for manual input -->
                                    <StackPanel Grid.Row="1">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <!-- Show ONLY if URL is NOT valid and it's a URL type -->
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding IsUrlValid}" Value="False" />
                                                            <Condition Binding="{Binding Type}" Value="{x:Static models:ActionType.Url}" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Warning tag -->
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                            <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M13,17h-2v-2h-2v-2h4v-2h-4V9h4v2h2v4h-2V17z" 
                                                  Fill="{StaticResource WarningBrush}" Width="12" Height="12" Margin="0,0,6,0" Stretch="Uniform"/>
                                            <TextBlock Text="Browser tab captured, but URL is missing. Enter manually:" 
                                                       Foreground="{StaticResource WarningBrush}" 
                                                       FontSize="10" 
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                        <!-- Editable Address TextBox -->
                                        <TextBox Text="{Binding PathOrUrl, UpdateSourceTrigger=PropertyChanged}" 
                                                 Background="#251616" 
                                                 BorderBrush="{StaticResource DangerBrush}" 
                                                 Foreground="White"
                                                 FontSize="11" 
                                                 Padding="8,4" 
                                                 Height="24"
                                                 Tag="https://example.com" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <!-- Footer Control Buttons -->
        <Grid Grid.Row="2" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Validation warning or helper -->
            <TextBlock Text="Please fill in all missing URLs to enable Save." 
                       Foreground="{StaticResource DangerHoverBrush}" 
                       FontSize="12" 
                       FontWeight="SemiBold"
                       VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <!-- We can show this when Save command CanSave is false -->
                            <DataTrigger Binding="{Binding SaveCommand.CanExecute, FallbackValue=False}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding CancelCommand}"
                        Padding="24,10"
                        Margin="0,0,12,0">
                    <TextBlock Text="Cancel" />
                </Button>
                <Button Style="{StaticResource PrimaryButton}" 
                        Command="{Binding SaveCommand}"
                        Padding="24,10">
                    <TextBlock Text="Save Workspace" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
