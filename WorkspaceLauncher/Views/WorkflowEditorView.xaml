<UserControl x:Class="WorkspaceLauncher.Views.WorkflowEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WorkspaceLauncher.Converters"
             xmlns:models="clr-namespace:WorkspaceLauncher.Models"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="Transparent">

    <UserControl.Resources>
        <converters:IconToGeometryConverter x:Key="IconConverter" />
        
        <!-- Style to remove ListBox default selections styling -->
        <Style x:Key="CleanListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0,0,0,12"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tooltip Helper -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header Navigation -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource IconButton}" 
                        Command="{Binding SaveAndBackCommand}"
                        Padding="8" Margin="0,0,12,0">
                    <!-- Left Arrow SVG -->
                    <Path Data="M20,11H7.83l5.59-5.59L12,4l-8,8l8,8l1.41-1.41L7.83,13H20V11z" 
                          Fill="{StaticResource TextSecondaryBrush}" Width="16" Height="16" Stretch="Uniform" />
                </Button>
                <StackPanel>
                    <TextBlock Text="Edit Workspace" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="20" 
                               FontWeight="Bold" />
                    <TextBlock Text="Add, edit, or disable workflow execution commands." 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Capture Session Button inside the editor -->
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding CaptureSessionCommand}"
                        Margin="0,0,12,0"
                        ToolTip="Import current running apps, folders, and tabs into this workspace">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z M12,20c-4.41,0-8-3.59-8-8s3.59-8,8-8s8,3.59,8,8S16.41,20,12,20z" 
                              Fill="White" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" />
                        <TextBlock Text="Capture Session" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource SecondaryButton}" 
                        Command="{Binding GenerateLauncherCommand}"
                        Margin="0,0,12,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M19,19H5V5h7V3H5C3.89,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2v-7h-2V19z M14,3v2h3.59l-9.83,9.83l1.41,1.41L19,6.41V10h2V3H14z" 
                              Fill="White" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" />
                        <TextBlock Text="Generate Launcher" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource PrimaryButton}" 
                        Command="{Binding SaveAndBackCommand}">
                    <TextBlock Text="Done" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Main Workspace Splitter -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" /> <!-- Left Config Pane -->
                <ColumnDefinition Width="24" />  <!-- Spacing -->
                <ColumnDefinition Width="*" />   <!-- Right Actions Editor -->
            </Grid.ColumnDefinitions>

            <!-- Left Config Pane: Workspace Meta -->
            <Border Grid.Column="0" 
                    Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Padding="16"
                    VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="WORKSPACE META" 
                               Foreground="{StaticResource TextMutedBrush}" 
                               FontSize="10" 
                               FontWeight="Bold" 
                               Margin="0,0,0,12" />

                    <!-- Name Field -->
                    <TextBlock Text="Name" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding WorkflowName, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,0,0,16"/>

                    <!-- Description Field -->
                    <TextBlock Text="Description" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding WorkflowDescription, UpdateSourceTrigger=PropertyChanged}" 
                             MinLines="2" MaxLines="3" TextWrapping="Wrap" AcceptsReturn="True"
                             Margin="0,0,0,16"/>

                    <!-- Icon Picker -->
                    <TextBlock Text="Icon Symbol" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- Preview -->
                        <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" 
                                Background="{Binding WorkflowColor}" Margin="0,0,12,0">
                            <Path Data="{Binding WorkflowIcon, Converter={StaticResource IconConverter}}" 
                                  Fill="White" Width="16" Height="16" Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding AvailableIcons}" 
                                  SelectedItem="{Binding WorkflowIcon}"
                                  VerticalContentAlignment="Center" 
                                  Height="36"
                                  Background="#13131A" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}"/>
                    </Grid>

                    <!-- Color Picker (Squary Blocks) -->
                    <TextBlock Text="Theme Color" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Colors}" Margin="0,0,0,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" Rows="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="32" Height="32" Margin="4"
                                        ToolTip="{Binding}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border Width="24" Height="24" CornerRadius="3" Background="{Binding}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1">
                                                <Grid x:Name="Overlay" Visibility="Collapsed">
                                                    <!-- Simple indicator if selected -->
                                                </Grid>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                    <!-- Clicking color updates selected theme color hex -->
                                    <Button.InputBindings>
                                        <MouseBinding MouseAction="LeftClick" 
                                                      Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                    </Button.InputBindings>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Right Actions Editor -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search and Stats -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="32,10,12,10"
                             Tag="Search actions..."/>
                    <!-- Search Icon Overlay -->
                    <Path Data="M15.5,14h-0.79l-0.28-0.27C15.41,12.59,16,11.11,16,9.5C16,5.91,13.09,3,9.5,3S3,5.91,3,9.5S5.91,16,9.5,16c1.61,0,3.09-0.59,4.23-1.57l0.27,0.28v0.79l5,4.99L20.49,19l-4.99-5z M9.5,14C7.01,14,5,11.99,5,9.5S7.01,5,9.5,5S14,7.01,14,9.5S11.99,14,9.5,14z" 
                          Fill="{StaticResource TextMutedBrush}" 
                          Width="14" Height="14" 
                          HorizontalAlignment="Left" 
                          VerticalAlignment="Center" 
                          Margin="12,0,0,0" 
                          Stretch="Uniform"/>
                </Grid>

                <!-- Actions List -->
                <ListBox Grid.Row="1" 
                         ItemsSource="{Binding FilteredActions}" 
                         Style="{StaticResource CleanListBoxStyle}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:WorkflowAction}">
                            <Border Background="{StaticResource CardBrush}" 
                                    BorderBrush="{StaticResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="16,12"
                                    Margin="0,0,0,12">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />  <!-- Type icon -->
                                        <ColumnDefinition Width="*" />     <!-- Details & Paths -->
                                        <ColumnDefinition Width="Auto" />  <!-- Parameters (delay, state) -->
                                        <ColumnDefinition Width="Auto" />  <!-- Controls (Up, Down, Delete) -->
                                    </Grid.ColumnDefinitions>

                                    <!-- 1. Type Icon -->
                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="4" Background="#1D1D2C" Margin="0,0,12,0">
                                        <Path Fill="White" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path.Style>
                                                <Style TargetType="Path">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.App}">
                                                            <Setter Property="Data" Value="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Url}">
                                                            <Setter Property="Data" Value="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Folder}">
                                                            <Setter Property="Data" Value="M10,4H4C2.9,4,2.01,4.9,2.01,6L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.File}">
                                                            <Setter Property="Data" Value="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.89,2,1.99,2H18c1.1,0,2-0.9,2-2V8L14,2z" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Path.Style>
                                        </Path>
                                    </Border>

                                    <!-- 2. Details -->
                                    <Grid Grid.Column="1" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!-- Title -->
                                        <TextBox Grid.Row="0" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" 
                                                 FontWeight="Bold" FontSize="13" Background="Transparent" BorderThickness="0" Padding="0" Margin="0,0,0,4"/>

                                        <!-- Path / URL with Browser Dialog Button -->
                                        <Grid Grid.Row="1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Text="{Binding PathOrUrl, UpdateSourceTrigger=PropertyChanged}" 
                                                     FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" 
                                                     Background="Transparent" BorderThickness="0" Padding="0" TextWrapping="NoWrap"/>
                                            <Button Grid.Column="1" 
                                                    Command="{Binding DataContext.BrowsePathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="4,0" Height="20" Margin="6,0,0,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Url}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                                <Path Data="M19,19H5V5h7V3H5C3.89,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2v-7h-2V19z" 
                                                      Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Grid>

                                    <!-- 3. Params: Delay and Launch Window State -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                        <!-- Delay Box -->
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="Delay (ms)" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                            <TextBox Text="{Binding DelayMs, UpdateSourceTrigger=PropertyChanged}" 
                                                     Width="64" Height="26" Margin="0,4,0,0" Padding="4,2" 
                                                     HorizontalContentAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Window State Box -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Style.Triggers>
                                                        <!-- Window state only makes sense for App action -->
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Url}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Folder}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.File}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <TextBlock Text="Window State" Foreground="{StaticResource TextMutedBrush}" FontSize="9" FontWeight="Bold"/>
                                            <ComboBox ItemsSource="{Binding DataContext.LaunchStates, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                      SelectedItem="{Binding State}" 
                                                      Height="26" Width="90" Margin="0,4,0,0"
                                                      Background="#13131A" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- 4. Controls -->
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <!-- Enabled Toggle -->
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.ToggleEnableCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0" ToolTip="Enable/Disable action">
                                            <!-- Eye open/closed path -->
                                            <Path Width="14" Height="14" Stretch="Uniform">
                                                <Path.Style>
                                                    <Style TargetType="Path">
                                                        <Setter Property="Fill" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="True">
                                                                <!-- Eye Icon -->
                                                                <Setter Property="Data" Value="M12,4.5C7,4.5,2.73,7.61,1,12c1.73,4.39,6,7.5,11,7.5s9.27-3.11,11-7.5C21.27,7.61,17,4.5,12,4.5z M12,17c-2.76,0-5-2.24-5-5s2.24-5,5-5s5,2.24,5,5S14.76,17,12,17z" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                                                <!-- Eye Off Icon -->
                                                                <Setter Property="Data" Value="M12,4.5c5,0,9.27,3.11,11,7.5c-0.69,1.75-1.9,3.22-3.41,4.28l1.49,1.49l-1.41,1.41l-1.41-1.41l-2.07-2.07L12,11.59l-1.63,1.63L8.3,15.3l-1.49,1.49L5.4,18.2l-1.41-1.41l1.49-1.49C3.97,14.23,2.76,12.76,2,11c1.73-4.39,6-7.5,11-7.5z" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Path.Style>
                                            </Path>
                                        </Button>

                                        <!-- Duplicate -->
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.DuplicateActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0" ToolTip="Duplicate action">
                                            <Path Data="M16,8H8V16H16V8Z M18,2H4C2.9,2,2,2.9,2,4V18H4V4H18V2ZM20,6H8C6.9,6,6,6.9,6,8V20C6,21.1,6.9,22,8,22H20C21.1,22,22,21.1,22,20V8C22,6.9,21.1,6,20,6ZM20,20H8V8H20V20Z" 
                                                  Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </Button>

                                        <!-- Move Up -->
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.MoveUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,4,0">
                                            <Path Data="M4 12l1.41 1.41L11 7.83V20h2V7.83l5.58 5.59L20 12l-8-8-8 8z" 
                                                  Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </Button>

                                        <!-- Move Down -->
                                        <Button Style="{StaticResource IconButton}" 
                                                Command="{Binding DataContext.MoveDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,0">
                                            <Path Data="M20 12l-1.41-1.41L13 16.17V4h-2v12.17l-5.58-5.59L4 12l8 8 8-8z" 
                                                  Fill="{StaticResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" />
                                        </Button>

                                        <!-- Delete -->
                                        <Button Style="{StaticResource DangerButton}" 
                                                Command="{Binding DataContext.DeleteActionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Padding="8,6">
                                            <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z" 
                                                  Fill="White" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer toolbar to Add Action -->
                <Border Grid.Row="2" 
                        Background="#111118" 
                        BorderBrush="{StaticResource CardBorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="4" 
                        Padding="12,10"
                        Margin="0,8,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Add Launch Action:" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   VerticalAlignment="Center" 
                                   FontSize="12" 
                                   FontWeight="SemiBold"
                                   Margin="0,0,16,0"/>

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <!-- App -->
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding AddAppActionCommand}"
                                    Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M21,6H3C1.9,6,1,6.9,1,8v8c0,1.1,0.9,2,2,2h18c1.1,0,2-0.9,2-2V8C23,6.9,22.1,6,21,6z" 
                                          Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Margin="0,0,6,0" Stretch="Uniform" />
                                    <TextBlock Text="App (.exe)" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- URL -->
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding AddUrlActionCommand}"
                                    Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,2C6.48,2,2,6.48,2,12s4.48,10,10,10s10-4.48,10-10S17.52,2,12,2z" 
                                          Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Margin="0,0,6,0" Stretch="Uniform" />
                                    <TextBlock Text="Website URL" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- Folder -->
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding AddFolderActionCommand}"
                                    Padding="12,6" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M10,4H4C2.9,4,2.01,4.9,2.01,6L2,18c0,1.1,0.9,2,2,2h16c1.1,0,2-0.9,2-2V8c0-1.1-0.9-2-2-2h-8L10,4z" 
                                          Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Margin="0,0,6,0" Stretch="Uniform" />
                                    <TextBlock Text="Folder" FontSize="11" />
                                </StackPanel>
                            </Button>
                            <!-- File -->
                            <Button Style="{StaticResource SecondaryButton}" 
                                    Command="{Binding AddFileActionCommand}"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M14,2H6C4.9,2,4,2.9,4,4v16c0,1.1,0.89,2,1.99,2H18c1.1,0,2-0.9,2-2V8L14,2z" 
                                          Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Margin="0,0,6,0" Stretch="Uniform" />
                                    <TextBlock Text="File" FontSize="11" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
