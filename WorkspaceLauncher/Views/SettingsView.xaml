<UserControl x:Class="WorkspaceLauncher.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="700"
             Background="Transparent">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,24">
            <TextBlock Text="Settings" 
                       Foreground="{StaticResource TextPrimaryBrush}" 
                       FontSize="24" 
                       FontWeight="Bold" />
            <TextBlock Text="Configure launch behaviors, shortcut options, and defaults." 
                       Foreground="{StaticResource TextSecondaryBrush}" 
                       FontSize="13" 
                       Margin="0,4,0,0" />
        </StackPanel>

        <!-- Settings Options Grid -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="600" HorizontalAlignment="Left">
                
                <!-- Browser Group -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Target Browser" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Choose which browser should open your URL tabs. System Default launches via ShellExecute." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox Grid.Column="1" 
                                  ItemsSource="{Binding Browsers}" 
                                  SelectedItem="{Binding DefaultBrowser}" 
                                  Height="32" VerticalContentAlignment="Center"
                                  Background="#13131A" Foreground="White" BorderBrush="{StaticResource CardBorderBrush}"/>
                    </Grid>
                </Border>

                <!-- Delay Group -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="200" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Default Action Delay" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="The default time gap (in milliseconds) the executor waits before starting the next action." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBox Text="{Binding DefaultDelayMs, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="100" Height="32" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
                            <TextBlock Text="ms" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Startup Group -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,16,0">
                            <TextBlock Text="Launch on Windows Startup" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Automatically start Workspace Launcher when logging into Windows (launches the editor in the background)." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" 
                                  IsChecked="{Binding LaunchAtStartup, UpdateSourceTrigger=PropertyChanged}" 
                                  VerticalAlignment="Center" Margin="12,0,8,0"/>
                    </Grid>
                </Border>

                <!-- Shortcut Location Group -->
                <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="20" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="Default Shortcut Location" Foreground="White" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Where launcher shortcuts (.lnk files) are generated by default (e.g. your Desktop)." 
                                       Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0"/>
                        </StackPanel>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBox Text="{Binding DefaultLauncherLocation, UpdateSourceTrigger=PropertyChanged}" 
                                     Padding="12,8" FontSize="12"/>
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
