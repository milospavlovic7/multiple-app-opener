<UserControl x:Class="WorkspaceLauncher.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:converters="clr-namespace:WorkspaceLauncher.Converters"
             xmlns:models="clr-namespace:WorkspaceLauncher.Models"
             xmlns:viewmodels="clr-namespace:WorkspaceLauncher.ViewModels"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="Transparent">

    <UserControl.Resources>
        <converters:IconToGeometryConverter x:Key="IconConverter" />
        
        <!-- Boolean to Visibility Converter -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

        <!-- Reusable Workflow Card Template -->
        <DataTemplate x:Key="WorkflowCardTemplate" DataType="{x:Type models:Workflow}">
            <Border Width="230" 
                    Height="170" 
                    Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Margin="0,0,16,16" 
                    Padding="16">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource CardBorderHoverBrush}" />
                                <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Top details: Icon and Pin -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Accent Colored Icon (Squary) -->
                        <Border Width="40" Height="40" CornerRadius="4" Background="{Binding Color}">
                            <Path Data="{Binding Icon, Converter={StaticResource IconConverter}}" 
                                  Fill="White" 
                                  Width="18" Height="18" 
                                  Stretch="Uniform" 
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <!-- Pin Button -->
                        <Button Grid.Column="1" 
                                Style="{StaticResource IconButton}" 
                                Command="{Binding DataContext.PinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                VerticalAlignment="Top">
                            <Path Data="M16,12V4H17V2H7V4H8V12L6,14V16H11.2V22H12.8V16H18V14L16,12Z" 
                                  Fill="{Binding IsPinned, Converter={x:Null}, FallbackValue=#64748B}" 
                                  Width="12" Height="12" Stretch="Uniform" />
                        </Button>
                    </Grid>

                    <!-- Middle text: Title & Action count -->
                    <StackPanel Grid.Row="1" Margin="0,12,0,0">
                        <TextBlock Text="{Binding Name}" 
                                   Foreground="{StaticResource TextPrimaryBrush}" 
                                   FontWeight="Bold" 
                                   FontSize="14" 
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Actions.Count, StringFormat='{}{0} Launch Actions'}" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="11" 
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Bottom: Launch/Edit/Generate/Delete -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" 
                                Style="{StaticResource SecondaryButton}" 
                                Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                ToolTip="Launch Workspace"
                                Padding="10,6" Margin="0,0,6,0">
                            <Path Data="M8 5v14l11-7z" Fill="White" Width="10" Height="10" Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="1" 
                                Style="{StaticResource SecondaryButton}" 
                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                ToolTip="Edit Workspace"
                                Padding="10,6" Margin="0,0,6,0">
                            <Path Data="M3,17.25V21h3.75L17.81,9.94l-3.75-3.75L3,17.25z" Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="2" 
                                Style="{StaticResource SecondaryButton}" 
                                Command="{Binding DataContext.GenerateLauncherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                ToolTip="Create Desktop Shortcut"
                                Padding="10,6" Margin="0,0,6,0">
                            <Path Data="M19,19H5V5h7V3H5C3.89,3,3,3.9,3,5v14c0,1.1,0.9,2,2,2h14c1.1,0,2-0.9,2-2v-7h-2V19z M14,3v2h3.59l-9.83,9.83l1.41,1.41L19,6.41V10h2V3H14z" 
                                  Fill="{StaticResource TextSecondaryBrush}" Width="10" Height="10" Stretch="Uniform" />
                        </Button>

                        <Button Grid.Column="3" 
                                Style="{StaticResource DangerButton}" 
                                Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                CommandParameter="{Binding}"
                                ToolTip="Delete Workspace"
                                Padding="10,6" HorizontalAlignment="Right">
                            <Path Data="M6,19c0,1.1,0.9,2,2,2h8c1.1,0,2-0.9,2-2V7H6V19z M19,4h-3.5l-1-1h-5l-1,1H5v2h14V4z" Fill="White" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Header & Stats -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Workspace Dashboard" 
                           Foreground="{StaticResource TextPrimaryBrush}" 
                           FontSize="24" 
                           FontWeight="Bold" />
                <TextBlock Text="Select a workspace or generate desktop launchers to begin." 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="13" 
                           Margin="0,4,0,0" />
            </StackPanel>

            <Button Grid.Column="1" 
                    Style="{StaticResource PrimaryButton}" 
                    Command="{Binding CreateNewCommand}"
                    Padding="16,10">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M19,13h-6v6h-2v-6H5v-2h6V5h2v6h6V13z" 
                          Fill="White" Width="12" Height="12" Margin="0,0,8,0" Stretch="Uniform" />
                    <TextBlock Text="New Workspace" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Stats Counter Cards -->
        <UniformGrid Grid.Row="1" Columns="3" Margin="0,0,0,24">
            <!-- Stat 1 -->
            <Border Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Margin="0,0,12,0" 
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Active Workspaces" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12" 
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalWorkflowsCount}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Stat 2 -->
            <Border Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Margin="6,0,6,0" 
                    Padding="20,16">
                <StackPanel>
                    <TextBlock Text="Total Runs" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12" 
                               FontWeight="SemiBold" />
                    <TextBlock Text="{Binding TotalLaunches}" 
                               Foreground="{StaticResource TextPrimaryBrush}" 
                               FontSize="28" 
                               FontWeight="Bold" 
                               Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <!-- Stat 3 -->
            <Border Background="{StaticResource CardBrush}" 
                    BorderBrush="{StaticResource CardBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="4" 
                    Margin="12,0,0,0" 
                    Padding="20,16">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Status" 
                                   Foreground="{StaticResource TextSecondaryBrush}" 
                                   FontSize="12" 
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding LaunchStatusMessage, FallbackValue='Ready'}" 
                                   Foreground="{StaticResource SuccessBrush}" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Workflows Section -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Pinned Section -->
                <StackPanel Visibility="{Binding PinnedWorkflows.Any, Converter={StaticResource BoolToVisConverter}, FallbackValue=Collapsed}">
                    <TextBlock Text="Pinned Workspaces" 
                               Foreground="{StaticResource TextSecondaryBrush}" 
                               FontSize="12" 
                               FontWeight="Bold" 
                               Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding PinnedWorkflows}" Margin="0,0,0,24">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkflowCardTemplate}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- All Workspaces -->
                <TextBlock Text="All Workspaces" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Margin="0,0,0,12" />

                <ItemsControl ItemsSource="{Binding Workflows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource WorkflowCardTemplate}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
